generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model QuoteRequest {
  id            String   @id @default(cuid())
  name          String
  phone         String
  applicantType String
  onBehalfOf    String
  material      String
  from          String
  to            String
  requirement   String?
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model JobApplication {
  id            String   @id @default(cuid())
  fullName      String
  phone         String
  email         String?
  position      String
  experience    String?
  qualification String?
  address       String?
  resumeUrl     String?
  coverLetter   String?
  status        String   @default("RECEIVED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Employee {
  id                           String                  @id @default(cuid())
  employeeId                   String                  @unique
  fullName                     String
  phone                        String
  email                        String?
  dateOfBirth                  DateTime?
  gender                       String?
  address                      String?
  designation                  String
  department                   String?
  joiningDate                  DateTime
  employmentType               String?
  employmentStatus             String                  @default("ACTIVE")
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  bloodGroup                   String?
  emergencyContactAddress      String?
  emergencyContactAltPhone     String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  maritalStatus                String?
  spouseName                   String?
  advanceHistory               EmployeeAdvance[]
  auditLogs                    EmployeeAuditLog[]
  careerHistory                EmployeeCareerHistory[]
  documents                    EmployeeDocument[]
  insuranceHistory             EmployeeInsurance[]
  salaryHistory                EmployeeSalary[]
}

model EmployeeSalary {
  id            String    @id @default(cuid())
  employeeId    String
  basicSalary   Decimal
  allowances    Decimal   @default(0)
  deductions    Decimal   @default(0)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeAdvance {
  id              String   @id @default(cuid())
  employeeId      String
  amount          Decimal
  advanceDate     DateTime @default(now())
  reason          String?
  recoveredAmount Decimal  @default(0)
  status          String   @default("PENDING")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeCareerHistory {
  id                  String   @id @default(cuid())
  employeeId          String
  designation         String
  department          String?
  effectiveDate       DateTime
  previousDesignation String?
  remarks             String?
  createdAt           DateTime @default(now())
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeDocument {
  id                  String    @id @default(cuid())
  employeeId          String
  documentType        String
  documentName        String
  documentUrl         String
  documentReference   String?
  fileHash            String?
  fileSize            Int?
  fileMimeType        String?
  blobPath            String?
  uploadedIp          String?
  uploadedUserAgent   String?
  uploadedAt          DateTime  @default(now())
  verificationRemarks String?
  verificationStatus  String    @default("SUBMITTED")
  verifiedAt          DateTime?
  verifiedBy          String?
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmployeeInsurance {
  id                  String    @id @default(cuid())
  employeeId          String
  insuranceType       String
  provider            String
  policyNumber        String
  coverageAmount      Decimal?
  startDate           DateTime
  expiryDate          DateTime?
  status              String    @default("ACTIVE")
  verificationStatus  String    @default("SUBMITTED")
  policyDocumentUrl   String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  verificationRemarks String?
  verifiedAt          DateTime?
  verifiedBy          String?
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([policyNumber])
  @@index([verificationStatus])
}

model EmployeeAuditLog {
  id            String   @id @default(cuid())
  employeeId    String
  adminEmail    String
  action        String
  fieldName     String
  previousValue String?
  newValue      String?
  createdAt     DateTime @default(now())
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([adminEmail])
  @@index([createdAt])
}

model VehicleOwner {
  id               String                 @id @default(cuid())
  ownerId          String                 @unique
  ownerType        String                 @default("INDIVIDUAL")
  name             String
  companyName      String?
  phone            String
  email            String?
  address          String?
  pan              String?
  gstin            String?
  kycStatus        String                 @default("PENDING")
  accountStatus    String                 @default("PENDING")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  account          OwnerAccount?
  activationTokens OwnerActivationToken[]
  createdDocuments OwnerDocument[]
  vehicles         Vehicle[]
  agreements       VehicleAgreement[]

  @@index([phone])
  @@index([kycStatus])
  @@index([accountStatus])
}

model OwnerAccount {
  id              String       @id @default(cuid())
  ownerId         String       @unique
  passwordHash    String
  isActive        Boolean      @default(true)
  mustSetPassword Boolean      @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  owner           VehicleOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id                 String             @id @default(cuid())
  vehicleId          String             @unique
  registrationNumber String             @unique
  vehicleType        String
  make               String?
  model              String?
  manufacturingYear  Int?
  ownershipType      String
  ownerId            String
  status             String             @default("PENDING")
  rcNumber           String?
  rcExpiryDate       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  owner              VehicleOwner       @relation(fields: [ownerId], references: [id])
  agreements         VehicleAgreement[]

  @@index([ownerId])
  @@index([ownershipType])
  @@index([status])
}

model VehicleAgreement {
  id                        String       @id @default(cuid())
  agreementId               String       @unique
  ownerId                   String
  vehicleId                 String
  agreementType             String
  startDate                 DateTime
  expiryDate                DateTime?
  rateType                  String?
  rate                      Decimal?
  paymentTerms              String?
  fuelResponsibility        String?
  driverResponsibility      String?
  maintenanceResponsibility String?
  status                    String       @default("SUBMITTED")
  documentUrl               String?
  verifiedBy                String?
  verifiedAt                DateTime?
  verificationRemarks       String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  owner                     VehicleOwner @relation(fields: [ownerId], references: [id])
  vehicle                   Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([vehicleId])
  @@index([status])
  @@index([expiryDate])
}

model OwnerActivationToken {
  id        String       @id @default(cuid())
  ownerId   String
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  owner     VehicleOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([expiresAt])
}

model OwnerDocument {
  id                  String       @id @default(cuid())
  ownerId             String
  documentType        String
  documentName        String
  documentUrl         String
  documentReference   String?
  fileHash            String?
  fileSize            Int?
  fileMimeType        String?
  blobPath            String?
  uploadedIp          String?
  uploadedUserAgent   String?
  verificationStatus  String       @default("SUBMITTED")
  verificationRemarks String?
  verifiedBy          String?
  verifiedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  owner               VehicleOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  verifications       OwnerDocumentVerification[]
  verificationAudits  OwnerDocumentVerificationAudit[]

  @@index([ownerId])
  @@index([verificationStatus])
}

model OwnerDocumentVerification {
  id                 String         @id @default(cuid())
  documentId         String
  overallStatus      String         @default("PENDING")
  verificationSource String?
  sourceReference    String?
  checkedBy          String?
  checkedAt          DateTime?
  confidenceScore    Decimal?
  finalRemarks       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  document           OwnerDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  checks             OwnerDocumentVerificationCheck[]

  @@index([documentId])
  @@index([overallStatus])
  @@index([verificationSource])
}

model OwnerDocumentVerificationCheck {
  id             String                    @id @default(cuid())
  verificationId String
  checkType      String
  status         String
  source         String?
  reference      String?
  result         String?
  remarks        String?
  checkedAt      DateTime                  @default(now())

  verification   OwnerDocumentVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
  @@index([checkType])
  @@index([status])
}

model OwnerDocumentVerificationAudit {
  id             String   @id @default(cuid())
  documentId     String
  verificationId String?
  adminEmail      String?
  action         String
  previousStatus String?
  newStatus      String?
  remarks        String?
  createdAt      DateTime @default(now())

  document       OwnerDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([verificationId])
  @@index([adminEmail])
  @@index([createdAt])
}

